# Seeds the admin account on every boot (persistent mode only). Changing
# ADMIN_PASSWORD here and restarting re-syncs the stored hash, so it is still
# the way to reset the admin password — and it overwrites one changed in the UI.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Signs the session cookie. CHANGE THIS before exposing the app: with the
# default, anyone can forge a cookie claiming to be the admin.
#   openssl rand -hex 32
JWT_SECRET=secret-change-me

PERSISTENT_CONNECTION=true
# Address shown to users on error screens ("please report it to ...").
NEXT_PUBLIC_SUPPORT_EMAIL=you@example.com

# --- Database (PERSISTENT_CONNECTION=true only) -----------------------------
# Leave every DATABASE_* variable unset to keep the previous behaviour exactly:
# SQLite at ./data/connections.db. Nothing below is read when
# PERSISTENT_CONNECTION=false, where connections live in the browser session.

# sqlite | postgres | mysql
# DATABASE_TYPE=sqlite

# SQLite only. Relative paths resolve against the app's working directory.
# DATABASE_PATH=./data/connections.db

# Postgres and MySQL only. All four are required; the port defaults to
# 5432 for postgres and 3306 for mysql.
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_USERNAME=webentog
# DATABASE_PASSWORD=changeme
# DATABASE_NAME=webentog
